# Server Port (Default: 3000)
PORT=3000
NODE_ENV=development

# SMTP Email Configuration (Optional fallback for transactional & campaign emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Casa Central Store <ecommerce@casacentralstore.com>

# Optional Gemini API Key
GEMINI_API_KEY=
